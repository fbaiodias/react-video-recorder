{
  // Type-checks everything in src/. tsconfig.build.json emits lib/.
  "compilerOptions": {
    "target": "ES2019",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "types": []
  },
  "include": ["src"],
  // Stories run in Storybook (Vite), whose types bring in Node's timers.
  "exclude": ["src/**/*.stories.tsx"]
}
