{
  "name": "react-video-recorder",
  "main": "lib",
  "files": [
    "lib",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:e2e": "playwright test --project chromium --project firefox",
    "test:visual": "playwright test --project visual",
    "lint": "eslint --ext .js,.mjs .",
    "clean": "rimraf -rf lib",
    "build": "babel src -d lib --copy-files --ignore **/*.stories.js,**/*.test.js,**/*.browser-test.js",
    "build:watch": "babel --watch src -d lib --copy-files --ignore **/*.stories.js,**/*.test.js,**/*.browser-test.js",
    "prebuild": "yarn run clean",
    "prepublish": "cross-env NODE_ENV=production yarn run build",
    "start": "yarn run storybook",
    "storybook": "start-storybook -p 6006",
    "build-storybook": "build-storybook",
    "semantic-release": "semantic-release"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged && yarn test",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "**/*.{js,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "**/*.md": [
      "prettier --write"
    ],
    "**/*.yml": [
      "prettier --write"
    ]
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "peerDependencies": {
    "prop-types": "^15.7.2",
    "react": "^16.8.3 || ^17.0.0",
    "react-dom": "^16.8.3 || ^17.0.0",
    "styled-components": "^4.1.1"
  },
  "dependencies": {
    "fix-webm-duration": "^1.0.4",
    "lodash.merge": "^4.5.0",
    "react-svg-inline": "^2.1.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.2.3",
    "@babel/core": "^7.3.3",
    "@babel/plugin-proposal-class-properties": "^7.3.3",
    "@babel/plugin-proposal-object-rest-spread": "^7.3.2",
    "@babel/plugin-transform-runtime": "^7.2.0",
    "@babel/preset-env": "^7.3.1",
    "@babel/preset-react": "^7.0.0",
    "@commitlint/cli": "^8.3.5",
    "@commitlint/config-conventional": "^8.3.4",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-actions": "^6.0.21",
    "@storybook/addon-info": "^5.3.21",
    "@storybook/addon-knobs": "^6.0.21",
    "@storybook/addon-options": "^5.3.21",
    "@storybook/addons": "^6.0.21",
    "@storybook/react": "^6.0.21",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "babel-eslint": "^10.1.0",
    "babel-loader": "^8.0.5",
    "babel-plugin-styled-components": "^1.10.6",
    "cross-env": "^7.0.3",
    "eslint": "^7.9.0",
    "eslint-config-standard": "^14.1.1",
    "eslint-config-standard-react": "^9.2.0",
    "eslint-plugin-import": "^2.22.0",
    "eslint-plugin-jest": "^24.0.2",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^4.2.1",
    "eslint-plugin-react": "^7.20.6",
    "eslint-plugin-standard": "^4.0.1",
    "husky": "^4.3.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^10.4.0",
    "prettier": "^2.1.2",
    "prop-types": "^15.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^3.0.2",
    "semantic-release": "^17.2.3",
    "styled-components": "4",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "version": "0.0.0-development",
  "repository": {
    "type": "git",
    "url": "https://github.com/fbaiodias/react-video-recorder.git"
  },
  "license": "MIT"
}
