{
  "name": "react-video-recorder",
  "type": "commonjs",
  "main": "./lib/index.js",
  "module": "./lib/esm/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/esm/index.d.ts",
        "default": "./lib/esm/index.js"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    },
    "./styles.css": "./lib/styles.css",
    "./lib": {
      "import": {
        "types": "./lib/esm/index.d.ts",
        "default": "./lib/esm/index.js"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    },
    "./lib/*.js": {
      "import": {
        "types": "./lib/esm/*.d.ts",
        "default": "./lib/esm/*.js"
      },
      "require": {
        "types": "./lib/*.d.ts",
        "default": "./lib/*.js"
      }
    },
    "./lib/*": {
      "import": {
        "types": "./lib/esm/*.d.ts",
        "default": "./lib/esm/*.js"
      },
      "require": {
        "types": "./lib/*.d.ts",
        "default": "./lib/*.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "lib",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project \"unit-*\"",
    "test:watch": "vitest --project unit-hooks",
    "test:e2e": "playwright test --project chromium --project firefox",
    "test:visual": "playwright test --project visual",
    "lint": "eslint .",
    "typecheck": "tsc",
    "check:package": "yarn run build && publint --pack npm && attw --pack . --exclude-entrypoints styles.css",
    "clean": "rimraf lib",
    "build": "tsc -p tsconfig.build.cjs.json && tsc -p tsconfig.build.esm.json && node scripts/finish-build.mjs",
    "prebuild": "yarn run clean",
    "prepack": "yarn run build",
    "start": "yarn run storybook",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "semantic-release": "semantic-release"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged && yarn test",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "lint-staged": {
    "**/*.{js,mjs,ts,tsx}": [
      "eslint --fix"
    ],
    "**/*.md": [
      "prettier --write"
    ],
    "**/*.yml": [
      "prettier --write"
    ]
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "peerDependencies": {
    "prop-types": "^15.7.2",
    "react": "^16.8.3 || ^17.0.0",
    "react-dom": "^16.8.3 || ^17.0.0"
  },
  "dependencies": {
    "fix-webm-duration": "^1.0.4",
    "lodash.merge": "^4.5.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@commitlint/cli": "^8.3.5",
    "@commitlint/config-conventional": "^8.3.4",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/lodash.merge": "^4.6.9",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/styled-components": "^5.1.36",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^4.3.0",
    "jsdom": "^29.1.1",
    "lint-staged": "^10.4.0",
    "neostandard": "^0.14.1",
    "prettier": "^2.1.2",
    "prop-types": "^15.7.2",
    "publint": "^0.3.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^3.0.2",
    "semantic-release": "^17.2.3",
    "storybook": "^10.6.3",
    "styled-components": "4",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "version": "0.0.0-development",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fbaiodias/react-video-recorder.git"
  },
  "license": "MIT",
  "resolutions": {
    "@types/react": "^18.3.31",
    "@babel/parser": "^7.29.9",
    "@babel/types": "^7.29.8",
    "@babel/traverse": "^7.29.10",
    "@babel/generator": "^7.29.8",
    "@babel/template": "^7.29.7"
  }
}
